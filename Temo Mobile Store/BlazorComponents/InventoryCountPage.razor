@using System.Data
@using System.Globalization
@using TemoStore.Core.Entities
@using TemoStore.Core.Commands
@implements IDisposable

<div class="app-shell">

    <aside class="sidebar">
        <div class="sidebar-logo">📱 TEMO<br />MOBILE STORE</div>
        <nav class="sidebar-nav">
            @foreach (var item in NavItems)
            {
                bool isCurrent = item.Key == MainShell.PageKeys.InventoryCountBlazor;
                <button class="nav-item @(isCurrent ? "active" : "")" @onclick="() => Navigate(item.Key, isCurrent)">
                    <span class="nav-icon">@item.Icon</span> <span>@item.Text</span>
                </button>
            }
        </nav>
    </aside>

    <div class="main-area">

        <header class="topbar">
            <input class="topbar-search" placeholder="بحث عن منتج بالاسم أو الباركود... (F2)" disabled title="قريبًا" />
            <div class="topbar-right">
                <div class="topbar-datetime"><span>@nowText</span></div>
                <button class="icon-btn" disabled title="قريبًا">🔔</button>
                <button class="icon-btn" disabled title="قريبًا">🌙</button>
                <div class="topbar-user">
                    <div class="avatar">@userInitial</div>
                    <div>
                        <div class="user-name">@userName</div>
                        <div class="user-role">@userRole</div>
                    </div>
                </div>
            </div>
        </header>

        <div class="page-body">

            <div class="page-header">
                <div>
                    <h1>📋 جرد المخزن</h1>
                    <div class="breadcrumb">جرد المخزن &gt; عدّ وتسوية الكميات</div>
                </div>
            </div>

            @if (!AuthManager.IsAdmin)
            {
                <div class="alert alert-error">⚠️ الشاشة دي للمدير بس - مش عندك صلاحية الوصول ليها.</div>
            }
            else
            {
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-error">⚠️ @errorMessage</div>
                }
                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success">✅ @successMessage</div>
                }

                <div class="kpi-strip">
                    <div class="card kpi-chip">
                        <span class="kpi-chip-icon accent-blue">📦</span>
                        <div>
                            <div class="kpi-chip-value">@products.Count</div>
                            <div class="kpi-chip-label">عدد المنتجات</div>
                        </div>
                    </div>
                    <div class="card kpi-chip">
                        <span class="kpi-chip-icon accent-orange">✏️</span>
                        <div>
                            <div class="kpi-chip-value">@products.Count(p => p.HasDifference)</div>
                            <div class="kpi-chip-label">فروق مدخلة الآن</div>
                        </div>
                    </div>
                    <div class="card kpi-chip">
                        <span class="kpi-chip-icon accent-purple">🕓</span>
                        <div>
                            <div class="kpi-chip-value" style="font-size:13px">@lastAdjustmentDate</div>
                            <div class="kpi-chip-label">آخر جرد</div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="list-toolbar">
                        <input class="field-input" placeholder="بحث بالاسم أو الباركود..." value="@search" @oninput="e => search = e.Value?.ToString() ?? string.Empty" />
                        <button class="btn btn-outline" @onclick="ToggleLog">📋 سجل التسويات السابقة</button>
                        <button class="btn btn-primary" @onclick="SaveCount">💾 حفظ الجرد</button>
                    </div>

                    @if (showLog)
                    {
                        <div class="form-panel">
                            <div class="form-panel-title">سجل التسويات السابقة</div>
                            <table class="data-table">
                                <thead><tr><th>التاريخ والوقت</th><th>الفرق</th><th>الكمية بعد</th><th>الكمية قبل</th><th>اسم المنتج</th><th>الباركود</th></tr></thead>
                                <tbody>
                                    @foreach (var l in logRows)
                                    {
                                        <tr>
                                            <td class="muted">@l.Date</td>
                                            <td>@l.Difference</td>
                                            <td>@l.After</td>
                                            <td>@l.Before</td>
                                            <td>@l.ProductName</td>
                                            <td class="muted">@l.Barcode</td>
                                        </tr>
                                    }
                                    @if (logRows.Count == 0)
                                    {
                                        <tr><td colspan="6" class="empty-row">مفيش تسويات مسجّلة قبل كده</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="data-table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr><th>الفرق</th><th>الكمية الفعلية</th><th>الكمية بالنظام</th><th>اسم المنتج</th><th>الباركود</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var p in FilteredProducts)
                                {
                                    <tr>
                                        <td>
                                            @if (!p.HasCounted)
                                            {
                                                <span class="muted">—</span>
                                            }
                                            else if (p.Diff == 0)
                                            {
                                                <span class="trend-up">مطابق</span>
                                            }
                                            else if (p.Diff > 0)
                                            {
                                                <span class="accent-purple">+@p.Diff</span>
                                            }
                                            else
                                            {
                                                <span class="qty-low">@p.Diff</span>
                                            }
                                        </td>
                                        <td><input class="mini-input" type="number" value="@p.CountedQtyText" @oninput="e => OnCountedChanged(p, e)" /></td>
                                        <td>@p.SystemQty</td>
                                        <td>@p.Name</td>
                                        <td class="muted">@p.Barcode</td>
                                    </tr>
                                }
                                @if (FilteredProducts.Count == 0)
                                {
                                    <tr><td colspan="5" class="empty-row">مفيش منتجات مطابقة</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

@code {
    private readonly CultureInfo arCulture = new CultureInfo("ar-EG");

    private static readonly (string Key, string Text, string Icon)[] AllNavItems = new (string, string, string)[]
    {
        (MainShell.PageKeys.Home,           "الرئيسية",   "🏠"),
        (MainShell.PageKeys.HomeBlazor,     "الرئيسية (تجربة)", "🧪"),
        (MainShell.PageKeys.SalesBlazor,    "المبيعات",   "🛒"),
        (MainShell.PageKeys.InventoryBlazor,"المخزون",    "🗄️"),
        (MainShell.PageKeys.InventoryCountBlazor, "جرد المخزن", "📋"),
        (MainShell.PageKeys.MaintenanceBlazor,"الصيانة",    "🔧"),
        (MainShell.PageKeys.CustomersBlazor,"العملاء",   "👥"),
        (MainShell.PageKeys.SuppliersBlazor,"الموردين",   "🚚"),
        (MainShell.PageKeys.PurchasesBlazor,"المشتريات", "🧾"),
        (MainShell.PageKeys.TreasuryBlazor, "الخزينة",    "🏦"),
        (MainShell.PageKeys.ReportsBlazor,  "التقارير",   "📊"),
        (MainShell.PageKeys.AccountsBlazor, "الحسابات",   "📒"),
        (MainShell.PageKeys.AttendanceBlazor,"الحضور والمرتبات", "🧑‍💼"),
        (MainShell.PageKeys.SettingsBlazor, "الإعدادات",  "⚙️"),
    };

    private (string Key, string Text, string Icon)[] NavItems
    {
        get
        {
            var adminOnlyKeys = new HashSet<string> {
                MainShell.PageKeys.CustomersBlazor, MainShell.PageKeys.SuppliersBlazor, MainShell.PageKeys.PurchasesBlazor, MainShell.PageKeys.ReportsBlazor,
                MainShell.PageKeys.AccountsBlazor, MainShell.PageKeys.SettingsBlazor, MainShell.PageKeys.InventoryCountBlazor, MainShell.PageKeys.AttendanceBlazor
            };
            return AuthManager.IsAdmin ? AllNavItems : AllNavItems.Where(x => !adminOnlyKeys.Contains(x.Key)).ToArray();
        }
    }

    private System.Timers.Timer? clockTimer;
    private string nowText = "";
    private string userName = "";
    private string userRole = "";
    private string userInitial = "?";

    private string? errorMessage;
    private string? successMessage;

    private class CountRow
    {
        public required string Barcode { get; set; }
        public required string Name { get; set; }
        public int SystemQty { get; set; }
        public string CountedQtyText { get; set; } = "";
        public bool HasCounted => int.TryParse(CountedQtyText, out _);
        public int? Diff => int.TryParse(CountedQtyText, out var c) ? c - SystemQty : null;
        public bool HasDifference => HasCounted && Diff != 0;
    }

    private class LogRow
    {
        public required string Date { get; set; }
        public required string Barcode { get; set; }
        public required string ProductName { get; set; }
        public required string Before { get; set; }
        public required string After { get; set; }
        public required string Difference { get; set; }
    }

    private List<CountRow> products = new();
    private List<LogRow> logRows = new();
    private string search = "";
    private bool showLog;
    private string lastAdjustmentDate = "لا يوجد";

    private List<CountRow> FilteredProducts =>
        string.IsNullOrWhiteSpace(search)
            ? products
            : products.Where(p => p.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || p.Barcode.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override void OnInitialized()
    {
        userName = AuthManager.CurrentUsername ?? "مستخدم";
        userRole = AuthManager.IsAdmin ? "مدير النظام" : "موظف";
        userInitial = userName.Length > 0 ? userName.Substring(0, 1) : "?";

        RefreshNow();
        clockTimer = new System.Timers.Timer(30000);
        clockTimer.Elapsed += (s, e) => InvokeAsync(() => { RefreshNow(); StateHasChanged(); });
        clockTimer.Start();

        if (AuthManager.IsAdmin)
        {
            LoadProducts();
            LoadLog();
        }
    }

    public void Dispose() => clockTimer?.Dispose();

    private void RefreshNow() => nowText = DateTime.Now.ToString("dddd d MMMM yyyy - hh:mm tt", arCulture);

    private void Navigate(string key, bool isCurrent)
    {
        if (!isCurrent)
            MainShell.Instance?.OpenPageByKey(key);
    }

    private void LoadProducts()
    {
        products.Clear();
        var dt = InventoryRepository.GetProductsForCount();
        foreach (DataRow row in dt.Rows)
        {
            products.Add(new CountRow
            {
                Barcode = row["الباركود"].ToString() ?? "",
                Name = row["اسم المنتج"].ToString() ?? "",
                SystemQty = row["الكمية بالنظام"] == DBNull.Value ? 0 : Convert.ToInt32(row["الكمية بالنظام"])
            });
        }
    }

    private void LoadLog()
    {
        logRows.Clear();
        var dt = InventoryRepository.GetAdjustmentsLog();
        foreach (DataRow row in dt.Rows)
        {
            logRows.Add(new LogRow
            {
                Date = row["التاريخ والوقت"].ToString() ?? "",
                Barcode = row["الباركود"].ToString() ?? "",
                ProductName = row["اسم المنتج"].ToString() ?? "",
                Before = row["الكمية قبل الجرد"].ToString() ?? "",
                After = row["الكمية بعد الجرد"].ToString() ?? "",
                Difference = row["الفرق"].ToString() ?? ""
            });
        }
        lastAdjustmentDate = logRows.Count > 0 ? logRows[0].Date : "لا يوجد";
    }

    private void ToggleLog() => showLog = !showLog;

    private void OnCountedChanged(CountRow p, ChangeEventArgs e)
    {
        p.CountedQtyText = e.Value?.ToString() ?? "";
    }

    private void SaveCount()
    {
        errorMessage = null;
        successMessage = null;

        var changed = products.Where(p => p.HasDifference).ToList();
        if (changed.Count == 0)
        {
            errorMessage = "مفيش أي تغييرات لحفظها.";
            return;
        }

        try
        {
            var rows = changed.Select(p => new InventoryAdjustmentLine
            {
                Barcode = p.Barcode,
                ProductName = p.Name,
                SystemQty = p.SystemQty,
                CountedQty = p.SystemQty + p.Diff!.Value,
                Difference = p.Diff!.Value
            }).ToList();

            AppServices.CoreEngine.Execute(new SaveInventoryAdjustmentsCommand
            {
                Rows = rows,
                PerformedBy = AuthManager.CurrentUsername ?? "unknown"
            });

            successMessage = $"تم حفظ الجرد وتسوية {rows.Count} صنف بنجاح.";
            LoadProducts();
            LoadLog();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
