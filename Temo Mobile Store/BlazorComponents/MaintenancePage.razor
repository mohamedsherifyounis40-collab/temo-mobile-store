    private (string Key, string Text, string Icon)[] NavItems
    {
        get
        {
            var adminOnlyKeys = new HashSet<string> {
                MainShell.PageKeys.CustomersBlazor, MainShell.PageKeys.SuppliersBlazor, MainShell.PageKeys.PurchasesBlazor, MainShell.PageKeys.ReportsBlazor,
                MainShell.PageKeys.AccountsBlazor, MainShell.PageKeys.SettingsBlazor, MainShell.PageKeys.InventoryCountBlazor, MainShell.PageKeys.AttendanceBlazor
            };
            return AuthManager.IsAdmin ? AllNavItems : AllNavItems.Where(x => !adminOnlyKeys.Contains(x.Key)).ToArray();
        }
    }

    private System.Timers.Timer? clockTimer;
    private string nowText = "";
    private string userName = "";
    private string userRole = "";
    private string userInitial = "?";

    private string? errorMessage;
    private string? successMessage;

    private class TicketRow
    {
        public int Id { get; set; }
        public required string CustomerName { get; set; }
        public string CustomerPhone { get; set; } = "";
        public required string DeviceInfo { get; set; }
        public string IssueDescription { get; set; } = "";
        public string ReceivedDate { get; set; } = "";
        public string EstimatedCostText { get; set; } = "";
        public string ActualCostText { get; set; } = "";
        public decimal ActualCost => decimal.TryParse(ActualCostText, NumberStyles.Number, CultureInfo.InvariantCulture, out var v) ? v : 0;
        public required string Status { get; set; }
        public string DeliveredDate { get; set; } = "";
    }

    private List<TicketRow> tickets = new();
    private string statusFilter = "الكل";

    private bool showReceiveForm;
    private string custName = "", custPhone = "", deviceInfo = "", issueDescription = "", estimatedCost = "";

    private int? statusTicketId;
    private string statusTicketDevice = "";
    private string newStatus = "مستلم";

    private int? deliverTicketId;
    private string deliverTicketDevice = "";
    private string actualCost = "", deliverMethod = "";

    protected override void OnInitialized()
    {
        userName = AuthManager.CurrentUsername ?? "مستخدم";
        userRole = AuthManager.IsAdmin ? "مدير النظام" : "موظف";
        userInitial = userName.Length > 0 ? userName.Substring(0, 1) : "?";

        RefreshNow();
        clockTimer = new System.Timers.Timer(30000);
        clockTimer.Elapsed += (s, e) => InvokeAsync(() => { RefreshNow(); StateHasChanged(); });
        clockTimer.Start();

        LoadTickets();
    }

    public void Dispose() => clockTimer?.Dispose();

    private void RefreshNow() => nowText = DateTime.Now.ToString("dddd d MMMM yyyy - hh:mm tt", arCulture);

    private void Navigate(string key, bool isCurrent)
    {
        if (!isCurrent)
            MainShell.Instance?.OpenPageByKey(key);
    }

    private void LoadTickets()
    {
        tickets.Clear();
        var dt = MaintenanceRepository.GetMaintenanceTickets(statusFilter);
        foreach (DataRow row in dt.Rows)
        {
            tickets.Add(new TicketRow
            {
                Id = Convert.ToInt32(row["TicketId"]),
                CustomerName = row["العميل"].ToString() ?? "",
                CustomerPhone = row["التليفون"]?.ToString() ?? "",
                DeviceInfo = row["الجهاز"].ToString() ?? "",
                IssueDescription = row["العطل"]?.ToString() ?? "",
                ReceivedDate = row["تاريخ الاستلام"].ToString() ?? "",
                EstimatedCostText = row["التقديري"].ToString() ?? "",
                ActualCostText = row["الفعلي"].ToString() ?? "",
                Status = row["الحالة"].ToString() ?? "",
                DeliveredDate = row["تاريخ التسليم"].ToString() ?? ""
            });
        }
    }

    private void OnStatusFilterChanged(ChangeEventArgs e)
    {
        statusFilter = e.Value?.ToString() ?? "الكل";
        LoadTickets();
    }

    // ---------- استلام جهاز جديد ----------
    private void OpenReceiveForm()
    {
        showReceiveForm = true;
        statusTicketId = null;
        deliverTicketId = null;
        custName = custPhone = deviceInfo = issueDescription = estimatedCost = "";
        errorMessage = null;
    }

    private void SaveReceive()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(custName) || string.IsNullOrWhiteSpace(deviceInfo))
        {
            errorMessage = "اسم العميل والجهاز مطلوبين.";
            return;
        }
        decimal.TryParse(estimatedCost, out var cost);

        try
        {
            AppServices.CoreEngine.Execute(new ReceiveDeviceCommand
            {
                CustomerName = custName.Trim(),
                CustomerPhone = string.IsNullOrWhiteSpace(custPhone) ? null : custPhone.Trim(),
                DeviceInfo = deviceInfo.Trim(),
                IssueDescription = string.IsNullOrWhiteSpace(issueDescription) ? null : issueDescription.Trim(),
                EstimatedCost = cost,
                PerformedBy = AuthManager.CurrentUsername ?? "unknown"
            });
            successMessage = "تم استلام الجهاز بنجاح.";
            showReceiveForm = false;
            LoadTickets();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    // ---------- تحديث الحالة ----------
    private void OpenStatusForm(TicketRow t)
    {
        statusTicketId = t.Id;
        statusTicketDevice = t.DeviceInfo;
        newStatus = t.Status == "تم التسليم" || t.Status == "ملغي" ? "مستلم" : t.Status;
        showReceiveForm = false;
        deliverTicketId = null;
        errorMessage = null;
    }

    private void SaveStatus()
    {
        errorMessage = null;
        if (statusTicketId == null) return;
        try
        {
            AppServices.CoreEngine.Execute(new UpdateMaintenanceStatusCommand
            {
                TicketId = statusTicketId.Value,
                NewStatus = newStatus,
                PerformedBy = AuthManager.CurrentUsername ?? "unknown"
            });
            successMessage = "تم تحديث حالة التذكرة.";
            statusTicketId = null;
            LoadTickets();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    // ---------- تسليم وتحصيل ----------
    private void OpenDeliverForm(TicketRow t)
    {
        deliverTicketId = t.Id;
        deliverTicketDevice = t.DeviceInfo;
        actualCost = t.EstimatedCostText;
        deliverMethod = "";
        showReceiveForm = false;
        statusTicketId = null;
        errorMessage = null;
    }

    private void SaveDeliver()
    {
        errorMessage = null;
        if (deliverTicketId == null) return;
        if (!decimal.TryParse(actualCost, out var cost) || cost < 0)
        {
            errorMessage = "التكلفة الفعلية غير صحيحة.";
            return;
        }
        if (string.IsNullOrEmpty(deliverMethod))
        {
            errorMessage = "اختر وسيلة الدفع.";
            return;
        }
        if (UIHelpers.IsTodayClosed(deliverMethod))
        {
            errorMessage = "تم إقفال اليوم بالفعل، لا يمكن تسليم جهاز وتحصيل أجرة جديدة.";
            return;
        }

        try
        {
            AppServices.CoreEngine.Execute(new DeliverMaintenanceDeviceCommand
            {
                TicketId = deliverTicketId.Value,
                ActualCost = cost,
                Method = deliverMethod,
                PerformedBy = AuthManager.CurrentUsername ?? "unknown"
            });
            successMessage = "تم تسليم الجهاز وتحصيل الأجرة بنجاح.";
            deliverTicketId = null;
            LoadTickets();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
