@using System.Data
@using System.Globalization
@using TemoStore.Core.Commands
@implements IDisposable

<div class="app-shell">

    <aside class="sidebar">
        <div class="sidebar-logo">📱 TEMO<br />MOBILE STORE</div>
        <nav class="sidebar-nav">
            @foreach (var item in NavItems)
            {
                bool isCurrent = item.Key == MainShell.PageKeys.MaintenanceBlazor;
                <button class="nav-item @(isCurrent ? "active" : "")" @onclick="() => Navigate(item.Key, isCurrent)">
                    <span class="nav-icon">@item.Icon</span> <span>@item.Text</span>
                </button>
            }
        </nav>
    </aside>

    <div class="main-area">

        <header class="topbar">
            <input class="topbar-search" placeholder="بحث عن منتج بالاسم أو الباركود... (F2)" disabled title="قريبًا" />
            <div class="topbar-right">
                <div class="topbar-datetime"><span>@nowText</span></div>
                <button class="icon-btn" disabled title="قريبًا">🔔</button>
                <button class="icon-btn" disabled title="قريبًا">🌙</button>
                <div class="topbar-user">
                    <div class="avatar">@userInitial</div>
                    <div>
                        <div class="user-name">@userName</div>
                        <div class="user-role">@userRole</div>
                    </div>
                </div>
            </div>
        </header>

        <div class="page-body">

            <div class="page-header">
                <div>
                    <h1>🔧 الصيانة</h1>
                    <div class="breadcrumb">الصيانة &gt; تذاكر الصيانة</div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-error">⚠️ @errorMessage</div>
            }
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success">✅ @successMessage</div>
            }

            <div class="kpi-strip">
                <div class="card kpi-chip">
                    <span class="kpi-chip-icon accent-blue">🔧</span>
                    <div>
                        <div class="kpi-chip-value">@tickets.Count</div>
                        <div class="kpi-chip-label">عدد التذاكر</div>
                    </div>
                </div>
                <div class="card kpi-chip">
                    <span class="kpi-chip-icon accent-orange">⏳</span>
                    <div>
                        <div class="kpi-chip-value">@tickets.Count(t => t.Status == "مستلم" || t.Status == "جاري الفحص")</div>
                        <div class="kpi-chip-label">قيد المعالجة</div>
                    </div>
                </div>
                <div class="card kpi-chip">
                    <span class="kpi-chip-icon accent-green">📦</span>
                    <div>
                        <div class="kpi-chip-value">@tickets.Count(t => t.Status == "جاهز للتسليم")</div>
                        <div class="kpi-chip-label">جاهزة للتسليم</div>
                    </div>
                </div>
                <div class="card kpi-chip">
                    <span class="kpi-chip-icon accent-purple">💰</span>
                    <div>
                        <div class="kpi-chip-value">@tickets.Where(t => t.Status == "تم التسليم").Sum(t => t.ActualCost).ToString("N0") ج.م</div>
                        <div class="kpi-chip-label">إجمالي إيراد الصيانة</div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="list-toolbar">
                    <select class="field-input" style="max-width:220px" value="@statusFilter" @onchange="OnStatusFilterChanged">
                        <option value="الكل">الكل</option>
                        <option value="مستلم">مستلم</option>
                        <option value="جاري الفحص">جاري الفحص</option>
                        <option value="جاهز للتسليم">جاهز للتسليم</option>
                        <option value="تم التسليم">تم التسليم</option>
                        <option value="ملغي">ملغي</option>
                    </select>
                    <button class="btn btn-primary" @onclick="OpenReceiveForm">➕ استلام جهاز جديد</button>
                </div>

                @if (showReceiveForm)
                {
                    <div class="form-panel">
                        <div class="form-panel-title">استلام جهاز جديد للصيانة</div>
                        <div class="form-grid">
                            <div>
                                <label class="field-label">اسم العميل</label>
                                <input class="field-input" value="@custName" @oninput="e => custName = e.Value?.ToString() ?? string.Empty" />
                            </div>
                            <div>
                                <label class="field-label">رقم التليفون</label>
                                <input class="field-input" value="@custPhone" @oninput="e => custPhone = e.Value?.ToString() ?? string.Empty" />
                            </div>
                            <div>
                                <label class="field-label">الجهاز</label>
                                <input class="field-input" value="@deviceInfo" @oninput="e => deviceInfo = e.Value?.ToString() ?? string.Empty" />
                            </div>
                            <div>
                                <label class="field-label">وصف العطل</label>
                                <input class="field-input" value="@issueDescription" @oninput="e => issueDescription = e.Value?.ToString() ?? string.Empty" />
                            </div>
                            <div>
                                <label class="field-label">التكلفة التقديرية</label>
                                <input class="field-input" type="number" value="@estimatedCost" @oninput="e => estimatedCost = e.Value?.ToString() ?? string.Empty" />
                            </div>
                        </div>
                        <div class="form-actions">
                            <button class="btn btn-primary" @onclick="SaveReceive">💾 استلام</button>
                            <button class="btn btn-outline" @onclick="() => showReceiveForm = false">إلغاء</button>
                        </div>
                    </div>
                }

                @if (statusTicketId != null)
                {
                    <div class="form-panel">
                        <div class="form-panel-title">تحديث حالة تذكرة: @statusTicketDevice</div>
                        <div class="form-grid">
                            <div>
                                <label class="field-label">الحالة الجديدة</label>
                                <select class="field-input" value="@newStatus" @onchange="e => newStatus = e.Value?.ToString() ?? string.Empty">
                                    <option value="مستلم">مستلم</option>
                                    <option value="جاري الفحص">جاري الفحص</option>
                                    <option value="جاهز للتسليم">جاهز للتسليم</option>
                                    <option value="ملغي">ملغي</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-actions">
                            <button class="btn btn-primary" @onclick="SaveStatus">💾 تحديث</button>
                            <button class="btn btn-outline" @onclick="() => statusTicketId = null">إلغاء</button>
                        </div>
                    </div>
                }

                @if (deliverTicketId != null)
                {
                    <div class="form-panel">
                        <div class="form-panel-title">تسليم الجهاز وتحصيل الأجرة: @deliverTicketDevice</div>
                        <div class="form-grid">
                            <div>
                                <label class="field-label">التكلفة الفعلية</label>
                                <input class="field-input" type="number" value="@actualCost" @oninput="e => actualCost = e.Value?.ToString() ?? string.Empty" />
                            </div>
                            <div>
                                <label class="field-label">وسيلة الدفع</label>
                                <select class="field-input" value="@deliverMethod" @onchange="e => deliverMethod = e.Value?.ToString() ?? string.Empty">
                                    <option value="">اختر وسيلة</option>
                                    @foreach (var m in UIHelpers.PaymentMethods)
                                    {
                                        <option value="@m">@m</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-actions">
                            <button class="btn btn-primary" @onclick="SaveDeliver">💾 تسليم</button>
                            <button class="btn btn-outline" @onclick="() => deliverTicketId = null">إلغاء</button>
                        </div>
                    </div>
                }

                <div class="data-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr><th></th><th>تاريخ التسليم</th><th>الحالة</th><th>الفعلي</th><th>التقديري</th><th>تاريخ الاستلام</th><th>العطل</th><th>الجهاز</th><th>التليفون</th><th>العميل</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var t in tickets)
                            {
                                bool closed = t.Status == "تم التسليم" || t.Status == "ملغي";
                                <tr>
                                    <td>
                                        <div class="row-actions">
                                            <button class="row-action-btn edit" disabled="@(!AuthManager.IsAdmin || closed)" title="تحديث الحالة" @onclick="() => OpenStatusForm(t)">🔄</button>
                                            <button class="row-action-btn" disabled="@(!AuthManager.IsAdmin || closed)" title="تسليم" @onclick="() => OpenDeliverForm(t)">✅</button>
                                        </div>
                                    </td>
                                    <td class="muted">@t.DeliveredDate</td>
                                    <td>@t.Status</td>
                                    <td>@t.ActualCostText</td>
                                    <td>@t.EstimatedCostText</td>
                                    <td class="muted">@t.ReceivedDate</td>
                                    <td>@t.IssueDescription</td>
                                    <td>@t.DeviceInfo</td>
                                    <td class="muted">@t.CustomerPhone</td>
                                    <td>@t.CustomerName</td>
                                </tr>
                            }
                            @if (tickets.Count == 0)
                            {
                                <tr><td colspan="10" class="empty-row">مفيش تذاكر مطابقة</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

