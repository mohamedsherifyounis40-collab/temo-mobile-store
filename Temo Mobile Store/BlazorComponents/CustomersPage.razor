    private (string Key, string Text, string Icon)[] NavItems
    {
        get
        {
            var adminOnlyKeys = new HashSet<string> {
                MainShell.PageKeys.CustomersBlazor, MainShell.PageKeys.SuppliersBlazor, MainShell.PageKeys.PurchasesBlazor, MainShell.PageKeys.ReportsBlazor,
                MainShell.PageKeys.AccountsBlazor, MainShell.PageKeys.SettingsBlazor, MainShell.PageKeys.InventoryCountBlazor, MainShell.PageKeys.AttendanceBlazor
            };
            return AuthManager.IsAdmin ? AllNavItems : AllNavItems.Where(x => !adminOnlyKeys.Contains(x.Key)).ToArray();
        }
    }

    private System.Timers.Timer? clockTimer;
    private string nowText = "";
    private string userName = "";
    private string userRole = "";
    private string userInitial = "?";

    private string? errorMessage;
    private string? successMessage;

    private class CustomerRow
    {
        public int Id { get; set; }
        public required string Name { get; set; }
        public string Phone { get; set; } = "";
        public decimal TotalCredit { get; set; }
        public decimal TotalCollected { get; set; }
        public decimal Remaining { get; set; }
    }

    private class StatementRow
    {
        public required string Date { get; set; }
        public required string Type { get; set; }
        public required string Details { get; set; }
        public required string Amount { get; set; }
    }

    private List<CustomerRow> customers = new();
    private string search = "";

    private List<CustomerRow> FilteredCustomers =>
        string.IsNullOrWhiteSpace(search)
            ? customers
            : customers.Where(c => c.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || c.Phone.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();

    private bool showCustomerForm;
    private int? editingCustomerId;
    private string custName = "", custPhone = "";

    private bool showCollectForm;
    private string collectCustomerId = "", collectMethod = "", collectAmount = "";

    private int? statementCustomerId;
    private string statementCustomerName = "";
    private List<StatementRow> statementRows = new();

    protected override void OnInitialized()
    {
        userName = AuthManager.CurrentUsername ?? "مستخدم";
        userRole = AuthManager.IsAdmin ? "مدير النظام" : "موظف";
        userInitial = userName.Length > 0 ? userName.Substring(0, 1) : "?";

        RefreshNow();
        clockTimer = new System.Timers.Timer(30000);
        clockTimer.Elapsed += (s, e) => InvokeAsync(() => { RefreshNow(); StateHasChanged(); });
        clockTimer.Start();

        LoadCustomers();
    }

    public void Dispose() => clockTimer?.Dispose();

    private void RefreshNow() => nowText = DateTime.Now.ToString("dddd d MMMM yyyy - hh:mm tt", arCulture);

    private void Navigate(string key, bool isCurrent)
    {
        if (!isCurrent)
            MainShell.Instance?.OpenPageByKey(key);
    }

    private static decimal ParseFormattedDecimal(object value)
    {
        var text = value?.ToString() ?? "0";
        return decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out var result) ? result : 0;
    }

    private void LoadCustomers()
    {
        customers.Clear();
        var dt = CustomersRepository.GetCustomersWithBalances();
        foreach (DataRow row in dt.Rows)
        {
            customers.Add(new CustomerRow
            {
                Id = Convert.ToInt32(row["CustomerId"]),
                Name = row["اسم العميل"].ToString() ?? "",
                Phone = row["التليفون"]?.ToString() ?? "",
                TotalCredit = ParseFormattedDecimal(row["إجمالي المبيعات بالآجل"]),
                TotalCollected = ParseFormattedDecimal(row["إجمالي المحصّل"]),
                Remaining = ParseFormattedDecimal(row["المتبقي عليه"])
            });
        }
    }

    // ---------- إضافة/تعديل/حذف ----------
    private void OpenNewCustomerForm()
    {
        editingCustomerId = null;
        custName = custPhone = "";
        showCustomerForm = true;
        showCollectForm = false;
        errorMessage = null;
    }

    private void OpenEditCustomerForm(CustomerRow c)
    {
        editingCustomerId = c.Id;
        custName = c.Name;
        custPhone = c.Phone;
        showCustomerForm = true;
        showCollectForm = false;
        errorMessage = null;
    }

    private void SaveCustomer()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(custName))
        {
            errorMessage = "من فضلك أدخل اسم العميل.";
            return;
        }

        try
        {
            if (editingCustomerId == null)
            {
                CustomersRepository.AddCustomer(custName.Trim(), custPhone.Trim());
                successMessage = "تم إضافة العميل بنجاح.";
            }
            else
            {
                CustomersRepository.UpdateCustomer(editingCustomerId.Value, custName.Trim(), custPhone.Trim());
                successMessage = "تم تعديل بيانات العميل بنجاح.";
            }
            showCustomerForm = false;
            LoadCustomers();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void DeleteCustomer(CustomerRow c)
    {
        errorMessage = null;
        if (CustomersRepository.HasSales(c.Id))
        {
            errorMessage = "لا يمكن حذف هذا العميل لأن له مبيعات مسجّلة بالفعل.";
            return;
        }
        try
        {
            CustomersRepository.DeleteCustomer(c.Id);
            successMessage = "تم حذف العميل.";
            LoadCustomers();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    // ---------- كشف حساب ----------
    private void ShowStatement(CustomerRow c)
    {
        statementCustomerId = c.Id;
        statementCustomerName = c.Name;
        statementRows.Clear();
        var dt = CustomersRepository.GetCustomerStatement(c.Id);
        foreach (DataRow row in dt.Rows)
        {
            statementRows.Add(new StatementRow
            {
                Date = row["التاريخ"].ToString() ?? "",
                Type = row["النوع"].ToString() ?? "",
                Details = row["التفاصيل"].ToString() ?? "",
                Amount = row["المبلغ"].ToString() ?? ""
            });
        }
        showCustomerForm = false;
        showCollectForm = false;
        errorMessage = null;
    }

    // ---------- تحصيل من عميل ----------
    private void OpenCollectForm()
    {
        showCollectForm = true;
        showCustomerForm = false;
        collectCustomerId = collectMethod = collectAmount = "";
        errorMessage = null;
    }

    private void SaveCollection()
    {
        errorMessage = null;
        if (!int.TryParse(collectCustomerId, out var customerId))
        {
            errorMessage = "اختر عميل.";
            return;
        }
        if (string.IsNullOrEmpty(collectMethod))
        {
            errorMessage = "اختر وسيلة الدفع.";
            return;
        }
        if (!decimal.TryParse(collectAmount, out var amount) || amount <= 0)
        {
            errorMessage = "المبلغ لازم يكون أكبر من صفر.";
            return;
        }
        if (UIHelpers.IsTodayClosed(collectMethod))
        {
            errorMessage = "تم إقفال اليوم بالفعل، لا يمكن تسجيل تحصيل جديد.";
            return;
        }

        var customer = customers.FirstOrDefault(c => c.Id == customerId);
        if (customer == null)
        {
            errorMessage = "العميل غير موجود.";
            return;
        }

        try
        {
            AppServices.CoreEngine.Execute(new CollectFromCustomerCommand
            {
                CustomerId = customerId,
                CustomerName = customer.Name,
                Method = collectMethod,
                Amount = amount,
                PerformedBy = AuthManager.CurrentUsername ?? "unknown"
            });
            successMessage = $"تم تحصيل {amount:N2} ج.م من {customer.Name} بنجاح.";
            showCollectForm = false;
            LoadCustomers();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
