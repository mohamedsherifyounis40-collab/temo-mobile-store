@using System.Data
@using System.Globalization
@using TemoStore.Core.Commands
@implements IDisposable

<div class="app-shell">

    <aside class="sidebar">
        <div class="sidebar-logo">📱 TEMO<br />MOBILE STORE</div>
        <nav class="sidebar-nav">
            @foreach (var item in NavItems)
            {
                bool isCurrent = item.Key == MainShell.PageKeys.CustomersBlazor;
                <button class="nav-item @(isCurrent ? "active" : "")" @onclick="() => Navigate(item.Key, isCurrent)">
                    <span class="nav-icon">@item.Icon</span> <span>@item.Text</span>
                </button>
            }
        </nav>
    </aside>

    <div class="main-area">

        <header class="topbar">
            <input class="topbar-search" placeholder="بحث عن منتج بالاسم أو الباركود... (F2)" disabled title="قريبًا" />
            <div class="topbar-right">
                <div class="topbar-datetime"><span>@nowText</span></div>
                <button class="icon-btn" disabled title="قريبًا">🔔</button>
                <button class="icon-btn" disabled title="قريبًا">🌙</button>
                <div class="topbar-user">
                    <div class="avatar">@userInitial</div>
                    <div>
                        <div class="user-name">@userName</div>
                        <div class="user-role">@userRole</div>
                    </div>
                </div>
            </div>
        </header>

        <div class="page-body">

            <div class="page-header">
                <div>
                    <h1>👥 العملاء</h1>
                    <div class="breadcrumb">العملاء &gt; قائمة العملاء</div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-error">⚠️ @errorMessage</div>
            }
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success">✅ @successMessage</div>
            }

            <div class="kpi-strip">
                <div class="card kpi-chip">
                    <span class="kpi-chip-icon accent-blue">👥</span>
                    <div>
                        <div class="kpi-chip-value">@customers.Count</div>
                        <div class="kpi-chip-label">عدد العملاء</div>
                    </div>
                </div>
                <div class="card kpi-chip">
                    <span class="kpi-chip-icon accent-purple">🧾</span>
                    <div>
                        <div class="kpi-chip-value">@customers.Sum(c => c.TotalCredit).ToString("N0") ج.م</div>
                        <div class="kpi-chip-label">إجمالي المبيعات بالآجل</div>
                    </div>
                </div>
                <div class="card kpi-chip">
                    <span class="kpi-chip-icon accent-green">💰</span>
                    <div>
                        <div class="kpi-chip-value">@customers.Sum(c => c.TotalCollected).ToString("N0") ج.م</div>
                        <div class="kpi-chip-label">إجمالي المحصّل</div>
                    </div>
                </div>
                <div class="card kpi-chip">
                    <span class="kpi-chip-icon accent-red">⚠️</span>
                    <div>
                        <div class="kpi-chip-value">@customers.Sum(c => c.Remaining).ToString("N0") ج.م</div>
                        <div class="kpi-chip-label">إجمالي المتبقي</div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="list-toolbar">
                    <input class="field-input" placeholder="بحث بالاسم أو التليفون..." value="@search" @oninput="e => search = e.Value?.ToString() ?? string.Empty" />
                    <button class="btn btn-primary" @onclick="OpenNewCustomerForm">➕ إضافة عميل</button>
                    <button class="btn btn-outline" @onclick="OpenCollectForm">💰 تحصيل من عميل</button>
                </div>

                @if (showCustomerForm)
                {
                    <div class="form-panel">
                        <div class="form-panel-title">@(editingCustomerId == null ? "إضافة عميل جديد" : "تعديل العميل")</div>
                        <div class="form-grid">
                            <div>
                                <label class="field-label">اسم العميل</label>
                                <input class="field-input" value="@custName" @oninput="e => custName = e.Value?.ToString() ?? string.Empty" />
                            </div>
                            <div>
                                <label class="field-label">رقم التليفون</label>
                                <input class="field-input" value="@custPhone" @oninput="e => custPhone = e.Value?.ToString() ?? string.Empty" />
                            </div>
                        </div>
                        <div class="form-actions">
                            <button class="btn btn-primary" @onclick="SaveCustomer">💾 حفظ</button>
                            <button class="btn btn-outline" @onclick="() => showCustomerForm = false">إلغاء</button>
                        </div>
                    </div>
                }

                @if (showCollectForm)
                {
                    <div class="form-panel">
                        <div class="form-panel-title">تحصيل من عميل</div>
                        <div class="form-grid">
                            <div>
                                <label class="field-label">العميل</label>
                                <select class="field-input" value="@collectCustomerId" @onchange="e => collectCustomerId = e.Value?.ToString() ?? string.Empty">
                                    <option value="">اختر عميل</option>
                                    @foreach (var c in customers)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="field-label">وسيلة الدفع</label>
                                <select class="field-input" value="@collectMethod" @onchange="e => collectMethod = e.Value?.ToString() ?? string.Empty">
                                    <option value="">اختر وسيلة</option>
                                    @foreach (var m in UIHelpers.PaymentMethods)
                                    {
                                        <option value="@m">@m</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="field-label">المبلغ</label>
                                <input class="field-input" type="number" value="@collectAmount" @oninput="e => collectAmount = e.Value?.ToString() ?? string.Empty" />
                            </div>
                        </div>
                        <div class="form-actions">
                            <button class="btn btn-primary" @onclick="SaveCollection">💾 تحصيل</button>
                            <button class="btn btn-outline" @onclick="() => showCollectForm = false">إلغاء</button>
                        </div>
                    </div>
                }

                @if (statementCustomerId != null)
                {
                    <div class="form-panel">
                        <div class="form-panel-title">📄 كشف حساب: @statementCustomerName</div>
                        <table class="data-table">
                            <thead><tr><th>التاريخ</th><th>النوع</th><th>التفاصيل</th><th>المبلغ</th></tr></thead>
                            <tbody>
                                @foreach (var s in statementRows)
                                {
                                    <tr>
                                        <td class="muted">@s.Date</td>
                                        <td>@s.Type</td>
                                        <td>@s.Details</td>
                                        <td>@s.Amount</td>
                                    </tr>
                                }
                                @if (statementRows.Count == 0)
                                {
                                    <tr><td colspan="4" class="empty-row">مفيش حركات لسه</td></tr>
                                }
                            </tbody>
                        </table>
                        <div class="form-actions">
                            <button class="btn btn-outline" @onclick="() => statementCustomerId = null">إغلاق كشف الحساب</button>
                        </div>
                    </div>
                }

                <div class="data-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr><th></th><th>المتبقي</th><th>إجمالي المحصّل</th><th>إجمالي الآجل</th><th>التليفون</th><th>اسم العميل</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var c in FilteredCustomers)
                            {
                                <tr>
                                    <td>
                                        <div class="row-actions">
                                            <button class="row-action-btn" title="كشف حساب" @onclick="() => ShowStatement(c)">📄</button>
                                            <button class="row-action-btn edit" title="تعديل" @onclick="() => OpenEditCustomerForm(c)">✏️</button>
                                            <button class="row-action-btn delete" title="حذف" @onclick="() => DeleteCustomer(c)">🗑</button>
                                        </div>
                                    </td>
                                    <td>
                                        @if (c.Remaining > 0)
                                        {
                                            <span class="qty-low">@c.Remaining.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            @c.Remaining.ToString("N2")
                                        }
                                    </td>
                                    <td>@c.TotalCollected.ToString("N2")</td>
                                    <td>@c.TotalCredit.ToString("N2")</td>
                                    <td class="muted">@c.Phone</td>
                                    <td>@c.Name</td>
                                </tr>
                            }
                            @if (FilteredCustomers.Count == 0)
                            {
                                <tr><td colspan="6" class="empty-row">مفيش عملاء مطابقين</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

@code {
