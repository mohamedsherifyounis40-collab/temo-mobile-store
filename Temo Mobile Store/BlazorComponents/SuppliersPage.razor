@using System.Data
@using System.Globalization
@using TemoStore.Core.Commands
@implements IDisposable

<div class="app-shell">

    <aside class="sidebar">
        <div class="sidebar-logo">📱 TEMO<br />MOBILE STORE</div>
        <nav class="sidebar-nav">
            @foreach (var item in NavItems)
            {
                bool isCurrent = item.Key == MainShell.PageKeys.SuppliersBlazor;
                <button class="nav-item @(isCurrent ? "active" : "")" @onclick="() => Navigate(item.Key, isCurrent)">
                    <span class="nav-icon">@item.Icon</span> <span>@item.Text</span>
                </button>
            }
        </nav>
    </aside>

    <div class="main-area">

        <header class="topbar">
            <input class="topbar-search" placeholder="بحث عن منتج بالاسم أو الباركود... (F2)" disabled title="قريبًا" />
            <div class="topbar-right">
                <div class="topbar-datetime"><span>@nowText</span></div>
                <button class="icon-btn" disabled title="قريبًا">🔔</button>
                <button class="icon-btn" disabled title="قريبًا">🌙</button>
                <div class="topbar-user">
                    <div class="avatar">@userInitial</div>
                    <div>
                        <div class="user-name">@userName</div>
                        <div class="user-role">@userRole</div>
                    </div>
                </div>
            </div>
        </header>

        <div class="page-body">

            <div class="page-header">
                <div>
                    <h1>🚚 الموردين</h1>
                    <div class="breadcrumb">الموردين &gt; قائمة الموردين</div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-error">⚠️ @errorMessage</div>
            }
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success">✅ @successMessage</div>
            }

            <div class="kpi-strip">
                <div class="card kpi-chip">
                    <span class="kpi-chip-icon accent-blue">🚚</span>
                    <div>
                        <div class="kpi-chip-value">@suppliers.Count</div>
                        <div class="kpi-chip-label">عدد الموردين</div>
                    </div>
                </div>
                <div class="card kpi-chip">
                    <span class="kpi-chip-icon accent-purple">🧾</span>
                    <div>
                        <div class="kpi-chip-value">@suppliers.Sum(s => s.TotalPurchases).ToString("N0") ج.م</div>
                        <div class="kpi-chip-label">إجمالي المشتريات</div>
                    </div>
                </div>
                <div class="card kpi-chip">
                    <span class="kpi-chip-icon accent-green">💰</span>
                    <div>
                        <div class="kpi-chip-value">@suppliers.Sum(s => s.TotalPaid).ToString("N0") ج.م</div>
                        <div class="kpi-chip-label">إجمالي المسدد</div>
                    </div>
                </div>
                <div class="card kpi-chip">
                    <span class="kpi-chip-icon accent-red">⚠️</span>
                    <div>
                        <div class="kpi-chip-value">@suppliers.Sum(s => s.Remaining).ToString("N0") ج.م</div>
                        <div class="kpi-chip-label">إجمالي المتبقي</div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="list-toolbar">
                    <input class="field-input" placeholder="بحث بالاسم أو التليفون..." value="@search" @oninput="e => search = e.Value?.ToString() ?? string.Empty" />
                    <button class="btn btn-primary" @onclick="OpenNewSupplierForm">➕ إضافة مورد</button>
                    <button class="btn btn-outline" @onclick="OpenPayForm">💰 سداد لمورد</button>
                </div>

                @if (showSupplierForm)
                {
                    <div class="form-panel">
                        <div class="form-panel-title">@(editingSupplierId == null ? "إضافة مورد جديد" : "تعديل المورد")</div>
                        <div class="form-grid">
                            <div>
                                <label class="field-label">اسم المورد</label>
                                <input class="field-input" value="@supName" @oninput="e => supName = e.Value?.ToString() ?? string.Empty" />
                            </div>
                            <div>
                                <label class="field-label">رقم التليفون</label>
                                <input class="field-input" value="@supPhone" @oninput="e => supPhone = e.Value?.ToString() ?? string.Empty" />
                            </div>
                        </div>
                        <div class="form-actions">
                            <button class="btn btn-primary" @onclick="SaveSupplier">💾 حفظ</button>
                            <button class="btn btn-outline" @onclick="() => showSupplierForm = false">إلغاء</button>
                        </div>
                    </div>
                }

                @if (showPayForm)
                {
                    <div class="form-panel">
                        <div class="form-panel-title">سداد لمورد</div>
                        <div class="form-grid">
                            <div>
                                <label class="field-label">المورد</label>
                                <select class="field-input" value="@paySupplierId" @onchange="e => paySupplierId = e.Value?.ToString() ?? string.Empty">
                                    <option value="">اختر مورد</option>
                                    @foreach (var s in suppliers)
                                    {
                                        <option value="@s.Id">@s.Name</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="field-label">وسيلة الدفع</label>
                                <select class="field-input" value="@payMethod" @onchange="e => payMethod = e.Value?.ToString() ?? string.Empty">
                                    <option value="">اختر وسيلة</option>
                                    @foreach (var m in UIHelpers.PaymentMethods)
                                    {
                                        <option value="@m">@m</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="field-label">المبلغ</label>
                                <input class="field-input" type="number" value="@payAmount" @oninput="e => payAmount = e.Value?.ToString() ?? string.Empty" />
                            </div>
                        </div>
                        <div class="form-actions">
                            <button class="btn btn-primary" @onclick="SavePayment">💾 سداد</button>
                            <button class="btn btn-outline" @onclick="() => showPayForm = false">إلغاء</button>
                        </div>
                    </div>
                }

                @if (statementSupplierId != null)
                {
                    <div class="form-panel">
                        <div class="form-panel-title">📄 كشف حساب: @statementSupplierName</div>
                        <table class="data-table">
                            <thead><tr><th>التاريخ</th><th>النوع</th><th>التفاصيل</th><th>المبلغ</th></tr></thead>
                            <tbody>
                                @foreach (var s in statementRows)
                                {
                                    <tr>
                                        <td class="muted">@s.Date</td>
                                        <td>@s.Type</td>
                                        <td>@s.Details</td>
                                        <td>@s.Amount</td>
                                    </tr>
                                }
                                @if (statementRows.Count == 0)
                                {
                                    <tr><td colspan="4" class="empty-row">مفيش حركات لسه</td></tr>
                                }
                            </tbody>
                        </table>
                        <div class="form-actions">
                            <button class="btn btn-outline" @onclick="() => statementSupplierId = null">إغلاق كشف الحساب</button>
                        </div>
                    </div>
                }

                <div class="data-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr><th></th><th>المتبقي</th><th>إجمالي المسدد</th><th>إجمالي المشتريات</th><th>التليفون</th><th>اسم المورد</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var s in FilteredSuppliers)
                            {
                                <tr>
                                    <td>
                                        <div class="row-actions">
                                            <button class="row-action-btn" title="كشف حساب" @onclick="() => ShowStatement(s)">📄</button>
                                            <button class="row-action-btn edit" title="تعديل" @onclick="() => OpenEditSupplierForm(s)">✏️</button>
                                            <button class="row-action-btn delete" title="حذف" @onclick="() => DeleteSupplier(s)">🗑</button>
                                        </div>
                                    </td>
                                    <td>
                                        @if (s.Remaining > 0)
                                        {
                                            <span class="qty-low">@s.Remaining.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            @s.Remaining.ToString("N2")
                                        }
                                    </td>
                                    <td>@s.TotalPaid.ToString("N2")</td>
                                    <td>@s.TotalPurchases.ToString("N2")</td>
                                    <td class="muted">@s.Phone</td>
                                    <td>@s.Name</td>
                                </tr>
                            }
                            @if (FilteredSuppliers.Count == 0)
                            {
                                <tr><td colspan="6" class="empty-row">مفيش موردين مطابقين</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private readonly CultureInfo arCulture = new CultureInfo("ar-EG");

    private static readonly (string Key, string Text, string Icon)[] AllNavItems = new (string, string, string)[]
    {
        (MainShell.PageKeys.Home,           "الرئيسية",   "🏠"),
        (MainShell.PageKeys.SalesBlazor,    "المبيعات",   "🛒"),
        (MainShell.PageKeys.InventoryBlazor,"المخزون",    "🗄️"),
        (MainShell.PageKeys.InventoryCountBlazor, "جرد المخزن", "📋"),
        (MainShell.PageKeys.MaintenanceBlazor,"الصيانة",    "🔧"),
        (MainShell.PageKeys.CustomersBlazor,"العملاء",   "👥"),
        (MainShell.PageKeys.SuppliersBlazor,"الموردين",   "🚚"),
        (MainShell.PageKeys.PurchasesBlazor,"المشتريات", "🧾"),
        (MainShell.PageKeys.TreasuryBlazor, "الخزينة",    "🏦"),
        (MainShell.PageKeys.ReportsBlazor,  "التقارير",   "📊"),
        (MainShell.PageKeys.AccountsBlazor, "الحسابات",   "📒"),
        (MainShell.PageKeys.AttendanceBlazor,"الحضور والمرتبات", "🧑‍💼"),
        (MainShell.PageKeys.SettingsBlazor, "الإعدادات",  "⚙️"),
    };

    private (string Key, string Text, string Icon)[] NavItems
    {
        get
        {
            var adminOnlyKeys = new HashSet<string> {
                MainShell.PageKeys.CustomersBlazor, MainShell.PageKeys.SuppliersBlazor, MainShell.PageKeys.PurchasesBlazor, MainShell.PageKeys.ReportsBlazor,
                MainShell.PageKeys.AccountsBlazor, MainShell.PageKeys.SettingsBlazor, MainShell.PageKeys.InventoryCountBlazor, MainShell.PageKeys.AttendanceBlazor
            };
            return AuthManager.IsAdmin ? AllNavItems : AllNavItems.Where(x => !adminOnlyKeys.Contains(x.Key)).ToArray();
        }
    }

    private System.Timers.Timer? clockTimer;
    private string nowText = "";
    private string userName = "";
    private string userRole = "";
    private string userInitial = "?";

    private string? errorMessage;
    private string? successMessage;

    private class SupplierRow
    {
        public int Id { get; set; }
        public required string Name { get; set; }
        public string Phone { get; set; } = "";
        public decimal TotalPurchases { get; set; }
        public decimal TotalPaid { get; set; }
        public decimal Remaining { get; set; }
    }

    private class StatementRow
    {
        public required string Date { get; set; }
        public required string Type { get; set; }
        public required string Details { get; set; }
        public required string Amount { get; set; }
    }

    private List<SupplierRow> suppliers = new();
    private string search = "";

    private List<SupplierRow> FilteredSuppliers =>
        string.IsNullOrWhiteSpace(search)
            ? suppliers
            : suppliers.Where(s => s.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || s.Phone.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();

    private bool showSupplierForm;
    private int? editingSupplierId;
    private string supName = "", supPhone = "";

    private bool showPayForm;
    private string paySupplierId = "", payMethod = "", payAmount = "";

    private int? statementSupplierId;
    private string statementSupplierName = "";
    private List<StatementRow> statementRows = new();

    protected override void OnInitialized()
    {
        userName = AuthManager.CurrentUsername ?? "مستخدم";
        userRole = AuthManager.IsAdmin ? "مدير النظام" : "موظف";
        userInitial = userName.Length > 0 ? userName.Substring(0, 1) : "?";

        RefreshNow();
        clockTimer = new System.Timers.Timer(30000);
        clockTimer.Elapsed += (s, e) => InvokeAsync(() => { RefreshNow(); StateHasChanged(); });
        clockTimer.Start();

        LoadSuppliers();
    }

    public void Dispose() => clockTimer?.Dispose();

    private void RefreshNow() => nowText = DateTime.Now.ToString("dddd d MMMM yyyy - hh:mm tt", arCulture);

    private void Navigate(string key, bool isCurrent)
    {
        if (!isCurrent)
            MainShell.Instance?.OpenPageByKey(key);
    }

    private static decimal ParseFormattedDecimal(object value)
    {
        var text = value?.ToString() ?? "0";
        return decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out var result) ? result : 0;
    }

    private void LoadSuppliers()
    {
        suppliers.Clear();
        var dt = SuppliersRepository.GetSuppliersWithBalances();
        foreach (DataRow row in dt.Rows)
        {
            suppliers.Add(new SupplierRow
            {
                Id = Convert.ToInt32(row["SupplierId"]),
                Name = row["اسم المورد"].ToString() ?? "",
                Phone = row["التليفون"]?.ToString() ?? "",
                TotalPurchases = ParseFormattedDecimal(row["إجمالي المشتريات"]),
                TotalPaid = ParseFormattedDecimal(row["إجمالي المسدد"]),
                Remaining = ParseFormattedDecimal(row["المتبقي"])
            });
        }
    }

    // ---------- إضافة/تعديل/حذف ----------
    private void OpenNewSupplierForm()
    {
        editingSupplierId = null;
        supName = supPhone = "";
        showSupplierForm = true;
        showPayForm = false;
        errorMessage = null;
    }

    private void OpenEditSupplierForm(SupplierRow s)
    {
        editingSupplierId = s.Id;
        supName = s.Name;
        supPhone = s.Phone;
        showSupplierForm = true;
        showPayForm = false;
        errorMessage = null;
    }

    private void SaveSupplier()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(supName))
        {
            errorMessage = "من فضلك أدخل اسم المورد.";
            return;
        }

        try
        {
            if (editingSupplierId == null)
            {
                SuppliersRepository.AddSupplier(supName.Trim(), supPhone.Trim());
                successMessage = "تم إضافة المورد بنجاح.";
            }
            else
            {
                SuppliersRepository.UpdateSupplier(editingSupplierId.Value, supName.Trim(), supPhone.Trim());
                successMessage = "تم تعديل بيانات المورد بنجاح.";
            }
            showSupplierForm = false;
            LoadSuppliers();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void DeleteSupplier(SupplierRow s)
    {
        errorMessage = null;
        if (SuppliersRepository.HasPurchases(s.Id))
        {
            errorMessage = "لا يمكن حذف هذا المورد لأن له فواتير شراء مسجّلة بالفعل.";
            return;
        }
        try
        {
            SuppliersRepository.DeleteSupplier(s.Id);
            successMessage = "تم حذف المورد.";
            LoadSuppliers();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    // ---------- كشف حساب ----------
    private void ShowStatement(SupplierRow s)
    {
        statementSupplierId = s.Id;
        statementSupplierName = s.Name;
        statementRows.Clear();
        var dt = SuppliersRepository.GetSupplierStatement(s.Id);
        foreach (DataRow row in dt.Rows)
        {
            statementRows.Add(new StatementRow
            {
                Date = row["التاريخ"].ToString() ?? "",
                Type = row["النوع"].ToString() ?? "",
                Details = row["التفاصيل"].ToString() ?? "",
                Amount = row["المبلغ"].ToString() ?? ""
            });
        }
        showSupplierForm = false;
        showPayForm = false;
        errorMessage = null;
    }

    // ---------- سداد لمورد ----------
    private void OpenPayForm()
    {
        showPayForm = true;
        showSupplierForm = false;
        paySupplierId = payMethod = payAmount = "";
        errorMessage = null;
    }

    private void SavePayment()
    {
        errorMessage = null;
        if (!int.TryParse(paySupplierId, out var supplierId))
        {
            errorMessage = "اختر مورد.";
            return;
        }
        if (string.IsNullOrEmpty(payMethod))
        {
            errorMessage = "اختر وسيلة الدفع.";
            return;
        }
        if (!decimal.TryParse(payAmount, out var amount) || amount <= 0)
        {
            errorMessage = "المبلغ لازم يكون أكبر من صفر.";
            return;
        }
        if (UIHelpers.IsTodayClosed(payMethod))
        {
            errorMessage = "تم إقفال اليوم بالفعل، لا يمكن تسجيل سداد جديد.";
            return;
        }

        var supplier = suppliers.FirstOrDefault(s => s.Id == supplierId);
        if (supplier == null)
        {
            errorMessage = "المورد غير موجود.";
            return;
        }

        try
        {
            AppServices.CoreEngine.Execute(new PaySupplierCommand
            {
                SupplierId = supplierId,
                SupplierName = supplier.Name,
                Method = payMethod,
                Amount = amount,
                PerformedBy = AuthManager.CurrentUsername ?? "unknown"
            });
            successMessage = $"تم سداد {amount:N2} ج.م لـ {supplier.Name} بنجاح.";
            showPayForm = false;
            LoadSuppliers();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
