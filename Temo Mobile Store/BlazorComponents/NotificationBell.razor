@implements IDisposable

<div class="notif-bell-wrap">
    <button class="icon-btn" title="الإشعارات" @onclick="ToggleOpen">
        🔔
        @if (items.Count > 0)
        {
            <span class="notif-badge">@(items.Count > 9 ? "9+" : items.Count.ToString())</span>
        }
    </button>

    @if (isOpen)
    {
        <div class="notif-dropdown">
            <div class="notif-dropdown-title">🔔 الإشعارات</div>
            @if (items.Count == 0)
            {
                <div class="notif-empty">مفيش إشعارات جديدة دلوقتي 👍</div>
            }
            else
            {
                @foreach (var item in items)
                {
                    <div class="notif-row"><span>@item.Icon</span><span>@item.Text</span></div>
                }
            }
        </div>
    }
</div>

@code {
    // نفس منطق GetNotificationItems/RefreshNotificationBadge القديمة في MainShell.cs
    // بالظبط (جرس الإشعارات) - عن طريق NotificationsRepository المشتركة.
    private List<NotificationItem> items = new();
    private bool isOpen;
    private System.Timers.Timer? refreshTimer;

    protected override void OnInitialized()
    {
        Refresh();
        refreshTimer = new System.Timers.Timer(60000);
        refreshTimer.Elapsed += (s, e) => InvokeAsync(() => { Refresh(); StateHasChanged(); });
        refreshTimer.Start();
    }

    private void Refresh()
    {
        try { items = NotificationsRepository.GetNotificationItems(); }
        catch { }
    }

    private void ToggleOpen()
    {
        isOpen = !isOpen;
        if (isOpen) Refresh();
    }

    public void Dispose() => refreshTimer?.Dispose();
}
