<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Temo_Mobile_Store</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- الشاشات في البرنامج كلها مبنية بإحداثيات بكسل ثابتة مفترض إنها تشتغل على 100% Scaling.
         DpiUnawareGdiScaled بيخلي ويندوز يكبّر البرنامج كله (خط وخانات مع بعض) بدل ما البرنامج
         ياخد الـ DPI الحقيقي ويحصل تعارض بين حجم الخط الفعلي والمسافات الثابتة (تراكب لابلز/أعمدة). -->
    <ApplicationHighDpiMode>DpiUnawareGdiScaled</ApplicationHighDpiMode>
    <ApplicationIcon>temo_logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="temo_logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Guna.UI2.WinForms" Version="2.0.4.8" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WinForms" Version="2.0.5" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.14" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Database\DatabaseManager.cs">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\TemoStore.Core\TemoStore.Core.csproj" />
    <ProjectReference Include="..\src\TemoStore.EventBus\TemoStore.EventBus.csproj" />
    <ProjectReference Include="..\src\TemoStore.Engines\TemoStore.Engines.csproj" />
    <ProjectReference Include="..\src\TemoStore.Data\TemoStore.Data.csproj" />
  </ItemGroup>

</Project>